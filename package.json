{
  "name": "broward-ride",
  "version": "1.0.0",
  "description": "Real-time Broward County Transit tracker (unofficial)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "playwright test",
    "dev": "concurrently \"node --watch server.js\" \"browser-sync start --proxy localhost:8080 --files 'public/**/*,server.js' --no-notify --reload-delay 1000\""
  },
  "dependencies": {
    "@google-cloud/storage": "^7.22.0",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "browser-sync": "^3.0.4",
    "concurrently": "^9.2.5"
  }
}
